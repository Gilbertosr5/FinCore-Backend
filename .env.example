# -----------------------------------------------------------------------------
# FinCore API — variáveis de ambiente (copie para .env e ajuste)
# -----------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Nível de log do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Banco de dados:
#   postgres://usuario:senha@localhost:5432/fincore -> PostgreSQL real
#   pglite:./.data/pglite                         -> PostgreSQL embutido em arquivo (dev, sem instalar nada)
#   pglite:memory                                 -> PostgreSQL embutido em memória (testes)
DATABASE_URL=pglite:./.data/pglite
# Aplica as migrações ao iniciar o servidor
DB_MIGRATE_ON_START=true

# Origens permitidas no CORS (separadas por vírgula). Vazio = CORS desligado
# (recomendado: proxy do Vite, mesma origem).
CORS_ORIGINS=http://localhost:5173

# Cookies de sessão: true exige HTTPS (obrigatório em produção)
COOKIE_SECURE=false
# Sessão: expira após X minutos sem uso e, no máximo, após Y horas
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Fuso usado para "hoje" nas regras (datas futuras etc.)
APP_TIMEZONE=America/Sao_Paulo
# URL pública do frontend (links de redefinição de senha)
APP_PUBLIC_URL=http://localhost:5173

# Limite de tentativas em login/cadastro/recuperação de senha (por IP, por minuto)
AUTH_RATE_LIMIT_PER_MINUTE=10
